# Copy to `functions/.env` before deploying functions. `.env` is git-ignored.
# Firebase bundles this file with the function source as plain params.
# Secrets (RESEND_API_KEY, NOTION_API_KEY) are NOT set here — use:
#   firebase functions:secrets:set RESEND_API_KEY
#   firebase functions:secrets:set NOTION_API_KEY

# Inbox(es) that receive every contact-form submission. Comma-separate for more than one.
CONTACT_NOTIFY_EMAIL=you@example.com

# Sender on notification emails. The domain must be verified in Resend (DNS records).
CONTACT_FROM_EMAIL=The Straight Path <contact@thestraightpath.org>

# Notion database that receives one row per submission (32-hex id from the database URL).
NOTION_DATABASE_ID=

# Optional: Notion user id to set in "Assigned To" on each row (leave empty to skip).
NOTION_ASSIGNEE_ID=

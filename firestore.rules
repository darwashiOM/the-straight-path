rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // US-only shipping address (contact support requests, billboard orders).
    function isShippingAddress(a) {
      return a is map
        && a.keys().hasOnly(['street', 'city', 'state', 'zip'])
        && a.keys().hasAll(['street', 'city', 'state', 'zip'])
        && a.street is string && a.street.size() <= 200
        && a.city is string && a.city.size() <= 100
        && a.state is string && a.state.size() <= 40
        && a.zip is string && a.zip.size() <= 20;
    }

    // Public read, admin write
    match /articles/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /videos/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /links/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /faqs/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /resources/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /channels/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /series/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /topics/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /siteSettings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /pages/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /media/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Audit log — append-only by admins, readable by admins.
    match /auditLog/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // Write-only public, admin read.
    // The optional `support` block carries a new-Muslim support request
    // (mentor / Qur'an / hijab) with an optional US shipping address.
    match /contact-submissions/{id} {
      function isSupportRequest(s) {
        return s is map
          && s.keys().hasOnly(['requests', 'details', 'phone', 'address'])
          && s.keys().hasAll(['requests'])
          && s.requests is list
          && s.requests.size() >= 1
          && s.requests.size() <= 3
          && s.requests.hasOnly(['mentor', 'quran', 'hijab'])
          && (!('details' in s) || (s.details is string && s.details.size() <= 2000))
          && (!('phone' in s) || (s.phone is string && s.phone.size() <= 40))
          && (!('address' in s) || isShippingAddress(s.address));
      }
      allow create: if request.resource.data.keys().hasOnly([
          'name', 'email', 'message', 'createdAt', 'source', 'locale', 'type', 'support'
        ])
        && request.resource.data.keys().hasAll(['name', 'email', 'message'])
        && request.resource.data.name is string
        && request.resource.data.email is string
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 5000
        && request.resource.data.name.size() <= 120
        && request.resource.data.email.size() <= 200
        && (!('type' in request.resource.data)
            || request.resource.data.type in ['question', 'support'])
        && (!('support' in request.resource.data)
            || isSupportRequest(request.resource.data.support));
      allow read, update, delete: if isAdmin();
    }

    // Mobile-billboard sticker orders — write-only public, admin read.
    // `items` maps a billboard id to a quantity. Rules can't add the
    // quantities up, so the 7-sticker total and the ids are re-checked by
    // the `onBillboardOrder` function, which rejects anything else.
    match /billboard-orders/{id} {
      allow create: if request.resource.data.keys().hasOnly([
          'name', 'email', 'address', 'items', 'createdAt', 'source', 'locale'
        ])
        && request.resource.data.keys().hasAll(['name', 'email', 'address', 'items'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 200
        && isShippingAddress(request.resource.data.address)
        && request.resource.data.items is map
        && request.resource.data.items.size() >= 1
        && request.resource.data.items.size() <= 7
        && request.resource.data.items.values().hasOnly([1, 2, 3, 4, 5, 6, 7]);
      allow read, update, delete: if isAdmin();
    }

    // Admins collection — self-readable, admin-manageable
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if isAdmin();
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
